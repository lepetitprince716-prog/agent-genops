{
  "_workflow": {
    "format": 1,
    "title": "SDXL text to image with a hires fix",
    "locale": "en",
    "layout": {
      "preset": "stepped"
    },
    "models": [
      {
        "name": "sd_xl_base_1.0.safetensors",
        "url": "https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0/resolve/main/sd_xl_base_1.0.safetensors",
        "directory": "checkpoints"
      }
    ]
  },
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    },
    "_meta": {
      "title": "SDXL base 1.0"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "ckpt",
        "CLIP"
      ],
      "text": "a quiet alpine lake at dawn, thin mist over the water, pine forest on the shore, snow on the far peaks, soft morning light"
    },
    "_meta": {
      "title": "Positive prompt",
      "ui_role": "cockpit",
      "ui_expose": [
        "text"
      ]
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "ckpt",
        "CLIP"
      ],
      "text": "lowres, blurry, watermark, text, logo, signature"
    },
    "_meta": {
      "title": "Negative prompt",
      "ui_role": "cockpit"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": {
      "title": "Image size",
      "ui_role": "cockpit"
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "ckpt",
        "MODEL"
      ],
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "seed": 0,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    },
    "_meta": {
      "title": "First pass",
      "ui_seed": "fixed"
    }
  },
  "up": {
    "class_type": "LatentUpscaleBy",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "upscale_method": "nearest-exact",
      "scale_by": 1.5
    },
    "_meta": {
      "title": "Upscale latent"
    }
  },
  "sampler2": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "ckpt",
        "MODEL"
      ],
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "up",
        0
      ],
      "seed": 0,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.4
    },
    "_meta": {
      "title": "Second pass",
      "ui_seed": "fixed"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler2",
        0
      ],
      "vae": [
        "ckpt",
        "VAE"
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "sdxl_hires_fix"
    }
  }
}
