   "height": 1456,
   "crop": "disabled"
  },
  "_meta": {
   "title": "Fit to 1456, plain",
   "ui_optional": true,
   "ui_group": "ab"
  }
 },
 "ab_up_encode": {
  "class_type": "VAEEncode",
  "inputs": {
