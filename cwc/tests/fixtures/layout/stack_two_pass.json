   ],
   "vae": [
    "vae",
    "VAE"
   ]
  },
  "_meta": {
   "title": "Encode, plain",
   "ui_optional": true,
   "ui_group": "ab"
  }
 },
 "ab_up_sampler": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "lora",
    "MODEL"
   ],
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "latent_image": [
    "ab_up_encode",
    0
   ],
   "seed": 2026102717,
   "steps": 9,
   "cfg": 2.5,
   "sampler_name": "er_sde",
   "scheduler": "simple",
   "denoise": 0.35
  },
  "_meta": {
   "title": "Upscale sampler, plain",
   "ui_optional": true,
   "ui_group": "ab",
   "ui_seed": "fixed"
  }
 },
 "ab_up_decode": {
